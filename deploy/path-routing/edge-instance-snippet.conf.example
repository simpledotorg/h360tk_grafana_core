# Shared proxy headers for every instance location in the edge config.
# Install as /etc/nginx/snippets/h360tk-instance.conf.
#
# Note there is no URI on the proxy_pass in the edge server block, so the
# full path (/demo/upload/...) reaches the instance proxy unchanged. The
# instance is responsible for its own prefix; the edge must not strip it.

proxy_http_version 1.1;

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $h360tk_connection_upgrade;

proxy_buffering         off;
proxy_request_buffering off;
proxy_read_timeout      3600s;
proxy_send_timeout      3600s;
