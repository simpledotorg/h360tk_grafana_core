# ---------------------------------------------------------------------------
# Shared edge for toolkit.hearts360.org.
#
# One server block for the whole domain. Each H360 instance runs on its own
# EC2 box and serves its own prefix on port 80 (the `proxy` service in that
# instance's docker-compose.yml), so the edge only forwards — it never
# rewrites paths and never needs to know which services an instance runs.
#
# Adding an instance is one upstream + one location here, and nothing else.
# ---------------------------------------------------------------------------

upstream h360tk_demo        { server 10.0.0.11:80; }   # h360tk_demo box
upstream h360tk_india       { server 10.0.0.12:80; }   # h360tk_india box
upstream h360tk_philippines { server 10.0.0.13:80; }   # h360tk_philippines box
upstream h360tk_indonesia   { server 10.0.0.14:80; }   # h360tk_indonesia box
upstream h360tk_central     { server 10.0.0.15:80; }   # h360tk_central_dashboard box

map $http_upgrade $h360tk_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name toolkit.hearts360.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name toolkit.hearts360.org;

    # certbot --nginx -d toolkit.hearts360.org
    ssl_certificate     /etc/letsencrypt/live/toolkit.hearts360.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toolkit.hearts360.org/privkey.pem;

    client_max_body_size 2g;

    location /demo/        { include snippets/h360tk-instance.conf; proxy_pass http://h360tk_demo; }
    location /india/       { include snippets/h360tk-instance.conf; proxy_pass http://h360tk_india; }
    location /philippines/ { include snippets/h360tk-instance.conf; proxy_pass http://h360tk_philippines; }
    location /indonesia/   { include snippets/h360tk-instance.conf; proxy_pass http://h360tk_indonesia; }
    location /central/     { include snippets/h360tk-instance.conf; proxy_pass http://h360tk_central; }

    # /demo -> /demo/ etc. Without this the instance proxy never sees the
    # trailing slash and Grafana's sub-path routing 404s.
    location ~ ^/(demo|india|philippines|indonesia|central)$ {
        return 301 $scheme://$host$request_uri/;
    }

    location = / {
        default_type text/plain;
        return 200 "HEARTS360 Toolkit. Pick an instance, e.g. /demo/\n";
    }
}
